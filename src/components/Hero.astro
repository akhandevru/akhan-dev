---
import { siteConfig, content } from '../config';
const [first = '', ...rest] = siteConfig.name.split(' ');
const lines = [first, rest.join(' ')];
---
<section class="hero" id="intro" aria-labelledby="intro-heading">
  <div class="hero-top">
    <p>{siteConfig.role}</p>
    <p class:list={['availability', { available: siteConfig.available }]}><span aria-hidden="true"></span>{siteConfig.availability}</p>
  </div>

  <h1 id="intro-heading" data-hero-name>
    <span class="sr-only">{siteConfig.name}</span>
    {lines.map(line => (
      <span class="line" aria-hidden="true"><span class="line-in">{[...line].map(ch => <span class="ch">{ch}</span>)}</span></span>
    ))}
  </h1>

  <div class="hero-bottom">
    <p class="lead">{content.intro}</p>
    <a class="pill pill-solid pill-big" data-magnetic href={siteConfig.telegram} target="_blank" rel="noopener noreferrer">{content.ui.discussProject}</a>
  </div>
</section>

<style>
  .hero { position:relative; min-height:100dvh; display:grid; grid-template-rows:auto auto 1fr; padding:calc(var(--hh) + 4px) var(--gutter) clamp(28px,4vw,52px); max-width:1800px; margin-inline:auto }
  .hero-top { display:flex; flex-wrap:wrap; justify-content:space-between; gap:8px 24px; padding-bottom:14px; border-bottom:1px solid var(--line); font:12px/1.6 var(--mono); color:var(--secondary) }
  .availability { display:inline-flex; align-items:center; gap:8px }
  .availability>span { width:8px; height:8px; border-radius:50%; background:var(--muted) }
  .availability.available>span { background:var(--accent) }

  /* Имя в верхней части экрана, чтобы не закрывать экраны проектов в 3D-сцене ниже. */
  /* Имя смешивается с фоном (difference): над светлым диском дыры буквы темнеют, поэтому всегда читаются. */
  h1 { position:relative; z-index:2; mix-blend-mode:difference; margin-top:clamp(2px,1vh,12px); font:800 clamp(46px,12.4vw,230px)/.9 var(--display); letter-spacing:-.03em; text-transform:uppercase; padding-block:.04em }
  .line { display:block; overflow:hidden; padding-block:.03em }
  .line-in { display:block; white-space:nowrap; will-change:transform }
  .ch { display:inline-block }

  .hero-top,.hero-bottom { position:relative; z-index:2 }
  .hero-top p,.hero-bottom p { text-shadow:0 1px 18px rgba(5,5,6,.95),0 0 4px rgba(5,5,6,.8) }
  .hero-bottom { align-self:end; display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:end; gap:20px clamp(24px,4vw,64px) }
  .lead { max-width:32ch; font-size:clamp(20px,1.9vw,30px); line-height:1.35; font-weight:500; letter-spacing:-.02em; text-wrap:pretty }

  @media (prefers-reduced-motion:no-preference) {
    .hero-top,.hero-bottom { animation:hero-fade 900ms cubic-bezier(.16,1,.3,1) 500ms backwards }
    @keyframes hero-fade { from { opacity:0; transform:translateY(14px) } }
  }
  @media (max-width:900px) {
    .hero-bottom { grid-template-columns:1fr; align-items:start; gap:18px }
    .hero-bottom .pill { justify-self:start }
    h1 { font-size:clamp(44px,17vw,150px) }
  }
</style>
