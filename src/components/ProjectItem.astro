---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { content } from '../config';
interface Props { project: Project; index: number; eager?: boolean; stacked?: boolean; }
const { project, index, eager = false, stacked = false } = Astro.props;
---
<li class:list={['card', { stacked }]} id={`project-${project.id}`} style={`--i:${index}`}>
  <article aria-labelledby={`title-${project.id}`}>
    <div class="card-copy">
      <p class="card-meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{project.category}</span><span>{project.year}</span></p>
      <h3 id={`title-${project.id}`}><a href={project.demo}>{project.name}</a></h3>
      <p class="card-text">{project.description}</p>
      <ul class="chips" aria-label={`Технологии проекта «${project.name}»`}>{project.technologies.map(technology => <li>{technology}</li>)}</ul>
      <a class="pill" href={project.demo}>{content.ui.demo}<span class="sr-only">: {project.name}</span></a>
      <button class="preview-toggle" type="button" data-preview-toggle data-preview-target={`project-${project.id}`} data-reset-label={content.ui.previewReset} data-scroll-label={content.ui.previewScroll} aria-pressed="false" hidden>{content.ui.previewScroll}</button>
    </div>
    <a class="card-preview" href={project.demo} aria-label={`${project.previewLabel}. ${content.ui.projectPreview}: ${project.name}`} data-project-preview>
      <span class="browser-bar" aria-hidden="true"><span class="browser-dots"><i></i><i></i><i></i></span><span>{project.previewLabel}</span></span>
      <span class="project-window" data-preview-window>
        <Image class="preview-image" src={project.image} alt={`Главная страница сайта «${project.name}»`} widths={[480, 672, 840, 960, 1440]} sizes="(min-width: 901px) 55vw, calc(100vw - 80px)" format="avif" quality={55} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} data-preview-image />
      </span>
    </a>
  </article>
</li>

<style>
  @media (min-width:901px) {
    .card.stacked { position:sticky; top:calc(var(--hh) + var(--i) * 20px) }
    .card.stacked article { min-height:calc(100dvh - var(--hh) - 60px) }
  }
</style>
