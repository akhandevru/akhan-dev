---
import { siteConfig, content } from '../config';
// На странице раздела его ссылка отмечена сразу; на главной раздел подсвечивает скрипт по прокрутке.
const current = (path: string) => Astro.url.pathname === path ? 'page' : undefined;
---
<header class="site-header">
  <a class="wordmark" href="/#top" aria-label={`${siteConfig.brand}. ${content.ui.home}`}>
    <svg viewBox="0 0 100 100" aria-hidden="true"><defs><clipPath id="mark-clip"><rect x="0" y="8" width="100" height="84"/></clipPath></defs><g clip-path="url(#mark-clip)" stroke="currentColor" stroke-width="12" fill="none"><line x1="13.4" y1="2" x2="86.6" y2="98"/><line x1="86.6" y1="2" x2="13.4" y2="98"/></g><polygon class="wordmark-bar" points="33.24,72 66.76,72 75.90,84 24.10,84" fill="#C8FF2E"/></svg>
    <span>{siteConfig.brand}</span>
  </a>
  <!-- На компьютере разделы видны сразу, на узком экране они в меню. Палитра команд по-прежнему открывается на Ctrl+K. -->
  <nav class="header-nav" aria-label={content.ui.navigation}>
    {content.navigation.map(({ id, label, path }) => <a href={path} data-section={id} aria-current={current(path)}>{label}</a>)}
    <a class="header-cta" href={content.contactPath} data-section="contact" aria-current={current(content.contactPath)}>{content.ui.contact}</a>
  </nav>
  <div class="header-tools">
    <button class="menu-open" type="button" data-menu-open aria-haspopup="dialog" aria-controls="menu"><span>Меню</span><span class="menu-lines" aria-hidden="true"><i></i><i></i></span></button>
  </div>
</header>
