---
// Плашка в конце страниц разделов. На главной вместо неё блок «Контакты».
import { siteConfig, content } from '../config';
const { cta } = content.extras;
---
<section class="cta wrap" aria-labelledby="cta-heading">
  <div class="cta-panel" data-rise>
    <h2 id="cta-heading">{cta.title}</h2>
    <p>{cta.description}</p>
    <div class="cta-actions">
      <a class="cta-main" href={siteConfig.telegram} target="_blank" rel="noopener noreferrer">{cta.action}</a>
      <a class="cta-link" href={content.contactPath}>{cta.secondary}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block:var(--section) }
  /* Размер заголовка считается от ширины самой плашки (cqi), чтобы слово «Расскажите» помещалось целиком и не рвалось посреди. */
  .cta-panel { container-type:inline-size; display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); grid-template-areas:'title text' 'title actions'; align-items:end; gap:24px clamp(32px,5vw,96px); padding:clamp(22px,5vw,80px); border-radius:var(--radius); background:var(--panel-bg); color:var(--panel-text) }
  h2 { grid-area:title; align-self:start; font:800 clamp(22px,6cqi,84px)/1 var(--display); letter-spacing:-.04em; text-wrap:balance; overflow-wrap:break-word }
  p { grid-area:text; max-width:40ch; color:var(--panel-muted); font-size:clamp(16px,1.3vw,19px); line-height:1.65 }
  .cta-actions { grid-area:actions; display:flex; flex-wrap:wrap; align-items:center; gap:12px 28px }
  .cta-main { display:inline-flex; align-items:center; min-height:56px; padding:14px 30px; border-radius:999px; background:var(--panel-text); color:var(--panel-bg); font:600 16px/1.2 var(--sans) }
  .cta-link { display:inline-flex; align-items:center; min-height:44px; font:13px var(--mono); text-decoration:underline; text-underline-offset:4px }
  .cta a:focus-visible { outline:2px solid var(--panel-text); outline-offset:4px; border-radius:999px }
  @media (hover:hover) {
    .cta-main { transition:background-color 160ms ease,color 160ms ease,box-shadow 160ms ease }
    .cta-main:hover { background:transparent; color:var(--panel-text); box-shadow:inset 0 0 0 1.5px var(--panel-text) }
  }
  @media (max-width:900px) {
    .cta-panel { grid-template-columns:minmax(0,1fr); grid-template-areas:'title' 'text' 'actions' }
    h2 { font-size:clamp(22px,9.5cqi,72px) }
  }
</style>
