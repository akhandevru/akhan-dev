---
import SectionPage from '../layouts/SectionPage.astro';
import { content, siteConfig } from '../config';
const { contactBrief: brief, contactPage: page } = content.extras;
/** Ник из адреса: https://t.me/akhan_dev даёт akhan_dev. */
const handle = (url: string) => new URL(url).pathname.replace(/^\/+|\/+$/g, '');
const channels = [
  { ...page.channels[0], url: siteConfig.telegram, label: `@${handle(siteConfig.telegram)}` },
  { ...page.channels[1], url: siteConfig.github, label: handle(siteConfig.github) },
];
---
<SectionPage page="contact" name={content.ui.contact} path="/contact/">
  <header class="wrap page-head">
    <h1>{page.title}</h1>
    <p>{page.description}</p>
  </header>

  <section class="wrap" aria-label={page.title}>
    <ul class="channels">
      {channels.map(channel => (
        <li>
          <a href={channel.url} target="_blank" rel="noopener noreferrer">
            <span class="channel-name">{channel.name}</span>
            <span class="channel-handle">{channel.label}</span>
            <span class="channel-note">{channel.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap brief" aria-label={`${brief.title}. ${brief.nextTitle}`}>
    <div data-rise>
      <h2 class="extra-title">{brief.title}</h2>
      <p class="extra-intro">{brief.description}</p>
      <ul class="ask">{brief.items.map(item => <li>{item}</li>)}</ul>
    </div>
    <div data-rise>
      <h2 class="extra-title">{brief.nextTitle}</h2>
      <ol class="next">{brief.next.map(item => <li>{item}</li>)}</ol>
      <a class="more" href="/development/">{brief.nextLink}</a>
    </div>
  </section>

  <section class="section wrap builder-wrap" id="message" aria-labelledby="builder-heading">
    <div class="extra-head" data-rise>
      <h2 class="extra-title" id="builder-heading">{page.builderTitle}</h2>
      <p class="extra-intro">{page.builderDescription}</p>
      <p class="estimate-note" role="status" data-estimate-note hidden>{page.estimateNote}</p>
    </div>
    <form class="builder" data-builder data-estimate-head={page.estimateHead} data-estimate-total={page.estimateTotal}>
      <div class="fields">
        <div class="field">
          <label for="msg-business">{page.fields.business}</label>
          <input id="msg-business" name="business" type="text" autocomplete="organization" placeholder={page.placeholders.business} />
        </div>
        <fieldset class="field">
          <legend>{page.fields.need}</legend>
          <div class="chips-choice">
            {page.needs.map(need => <label><input type="checkbox" name="need" value={need} /><span>{need}</span></label>)}
          </div>
        </fieldset>
        <div class="field">
          <label for="msg-deadline">{page.fields.deadline}</label>
          <input id="msg-deadline" name="deadline" type="text" autocomplete="off" placeholder={page.placeholders.deadline} />
        </div>
        <div class="field">
          <label for="msg-details">{page.fields.details}</label>
          <textarea id="msg-details" name="details" rows="3" placeholder={page.placeholders.details}></textarea>
        </div>
      </div>
      <div class="preview">
        <label for="msg-preview">{page.preview}</label>
        <textarea id="msg-preview" readonly rows="8" data-builder-preview>Здравствуйте!</textarea>
        <div class="preview-actions">
          <button class="copy" type="button" data-builder-copy data-copied={page.copied} hidden>{page.copy}</button>
          <a class="open" href={siteConfig.telegram} target="_blank" rel="noopener noreferrer">{page.open}</a>
        </div>
        <p class="sr-only" role="status" data-builder-status></p>
      </div>
    </form>
  </section>
</SectionPage>

<script>
  // Текст собирается только в браузере и никуда не отправляется: его копируют и вставляют в Telegram сами.
  const form = document.querySelector<HTMLFormElement>('[data-builder]');
  const preview = form?.querySelector<HTMLTextAreaElement>('[data-builder-preview]');
  const copy = form?.querySelector<HTMLButtonElement>('[data-builder-copy]');
  const status = form?.querySelector<HTMLElement>('[data-builder-status]');
  if (form && preview && copy && status) {
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim() ?? '';
    const build = () => {
      const needs = [...form.querySelectorAll<HTMLInputElement>('input[name="need"]:checked')].map(input => input.value);
      const lines = ['Здравствуйте!'];
      if (value('business')) lines.push(`Чем занимаюсь: ${value('business')}.`);
      if (needs.length) lines.push(`Нужно: ${needs.join(', ')}.`);
      if (value('deadline')) lines.push(`Срок: ${value('deadline')}.`);
      if (value('details')) lines.push(value('details'));
      preview.value = lines.join('\n').replace(/\.\./g, '.');
    };
    form.addEventListener('input', build);
    form.addEventListener('submit', event => event.preventDefault());

    // Расчёт из калькулятора на странице стоимости: подставляем его в «Что ещё важно» и отмечаем выбранные услуги.
    try {
      const saved = sessionStorage.getItem('akhan-estimate');
      const details = form.elements.namedItem('details') as HTMLTextAreaElement | null;
      const parsed: unknown = saved ? JSON.parse(saved) : null;
      if (details && parsed && typeof parsed === 'object' && 'lines' in parsed && 'total' in parsed && Array.isArray(parsed.lines) && typeof parsed.total === 'number') {
        const money = (n: number) => `${n.toLocaleString('ru-RU')} ₽`;
        const rows = (parsed.lines as unknown[]).filter((line): line is [string, number] => Array.isArray(line) && typeof line[0] === 'string' && typeof line[1] === 'number');
        details.value = [form.dataset['estimateHead'] ?? '', ...rows.map(([name, price]) => `${name}: ${money(price)}`), `${form.dataset['estimateTotal'] ?? ''}: от ${money(parsed.total)}`].join('\n');
        details.rows = Math.min(8, rows.length + 3);
        rows.forEach(([name]) => {
          const chip = [...form.querySelectorAll<HTMLInputElement>('input[name="need"]')].find(input => input.value === name);
          if (chip) chip.checked = true;
        });
        document.querySelector<HTMLElement>('[data-estimate-note]')?.removeAttribute('hidden');
      }
    } catch { /* нет сохранённого расчёта или хранилище недоступно */ }
    build();
    const label = copy.textContent ?? '';
    copy.hidden = !navigator.clipboard;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(preview.value);
        copy.textContent = copy.dataset['copied'] ?? label;
        status.textContent = copy.dataset['copied'] ?? '';
        setTimeout(() => { copy.textContent = label; status.textContent = ''; }, 2000);
      } catch {
        preview.select();
      }
    });
  }
</script>

<style>
  .channels { border-top:1.5px solid var(--text) }
  .channels a { display:grid; grid-template-columns:minmax(0,1.7fr) minmax(0,.8fr) minmax(0,.8fr); align-items:baseline; gap:8px clamp(20px,4vw,64px); padding-block:clamp(20px,3vw,44px); border-bottom:1.5px solid var(--line) }
  .channel-name { font:800 clamp(40px,6vw,110px)/.95 var(--display); letter-spacing:-.055em }
  .channel-handle { font:clamp(14px,1.2vw,18px)/1.5 var(--mono) }
  .channel-note { color:var(--secondary); font-size:clamp(15px,1.2vw,18px) }
  .channels a:focus-visible { outline:2px solid var(--text); outline-offset:4px; border-radius:6px }
  @media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .channel-name { display:inline-block; transition:transform 420ms cubic-bezier(.2,.8,.2,1),color 160ms ease }
    .channels a:hover .channel-name { transform:translateX(clamp(8px,1.2vw,20px)) }
  }
  @media (hover:hover) { .channels a:hover .channel-handle { text-decoration:underline; text-underline-offset:4px } }

  .brief { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:clamp(40px,6vw,120px); align-items:start }
  .ask { margin-top:clamp(24px,3vw,40px); border-top:1.5px solid var(--text) }
  .ask li { padding-block:16px; border-bottom:1.5px solid var(--line); font:500 clamp(17px,1.4vw,21px)/1.4 var(--sans) }
  .next { display:grid; gap:20px; margin-top:clamp(24px,3vw,40px); counter-reset:step }
  .next li { display:grid; grid-template-columns:3ch 1fr; gap:16px; font-size:clamp(17px,1.4vw,21px); line-height:1.5; counter-increment:step }
  .next li::before { content:counter(step); font:700 1em/1.5 var(--display); color:var(--muted) }
  .more { display:inline-flex; align-items:center; min-height:44px; margin-top:20px; font:13px var(--mono); text-decoration:underline; text-underline-offset:4px }

  .builder-wrap { padding-bottom:var(--section) }
  .estimate-note { max-width:56ch; margin-top:14px; color:var(--text); font-size:15px; line-height:1.6 }
  .builder { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:clamp(28px,4vw,72px); align-items:start }
  .fields { display:grid; gap:24px }
  .field { display:grid; gap:8px; margin:0; padding:0; border:0; min-width:0 }
  .field > label,.field legend,.preview > label { padding:0; color:var(--secondary); font:13px/1.6 var(--mono) }
  .field legend { margin-bottom:8px }
  input[type="text"],textarea { width:100%; padding:14px 18px; border:1.5px solid var(--line); border-radius:16px; background:var(--surface); font-size:16px; line-height:1.5; resize:vertical }
  input[type="text"]::placeholder,textarea::placeholder { color:var(--muted); opacity:1 }
  input[type="text"]:focus-visible,textarea:focus-visible { outline:2px solid var(--text); outline-offset:2px; border-color:var(--text) }
  .chips-choice { display:flex; flex-wrap:wrap; gap:8px }
  .chips-choice label { position:relative; cursor:pointer }
  .chips-choice input { position:absolute; opacity:0; inset:0; margin:0; cursor:pointer }
  .chips-choice span { display:inline-flex; align-items:center; min-height:44px; padding:8px 18px; border:1.5px solid var(--line); border-radius:999px; font-size:15px }
  .chips-choice input:checked + span { background:var(--text); border-color:var(--text); color:var(--bg) }
  .chips-choice input:focus-visible + span { outline:2px solid var(--text); outline-offset:3px }
  .preview { position:sticky; top:calc(var(--hh) + 24px); display:grid; gap:12px; padding:clamp(22px,2.6vw,36px); border-radius:var(--radius); background:var(--panel-bg); color:var(--panel-text) }
  .preview > label { color:var(--panel-muted) }
  .preview textarea { min-height:200px; border-color:var(--panel-line); background:transparent; color:var(--panel-text); font-family:var(--sans) }
  .preview textarea:focus-visible { outline-color:var(--panel-text); border-color:var(--panel-text) }
  .preview-actions { display:flex; flex-wrap:wrap; gap:12px }
  .copy,.open { display:inline-flex; align-items:center; min-height:52px; padding:12px 28px; border-radius:999px; font:600 15px/1.2 var(--sans) }
  .copy { border:0; background:var(--panel-text); color:var(--panel-bg) }
  .open { box-shadow:inset 0 0 0 1.5px var(--panel-text) }
  .copy:focus-visible,.open:focus-visible { outline:2px solid var(--panel-text); outline-offset:4px }
  @media (hover:hover) {
    .copy,.open { transition:background-color 160ms ease,color 160ms ease,box-shadow 160ms ease }
    .copy:hover { background:transparent; color:var(--panel-text); box-shadow:inset 0 0 0 1.5px var(--panel-text) }
    .open:hover { background:var(--panel-text); color:var(--panel-bg) }
  }

  @media (max-width:900px) {
    .channels a { grid-template-columns:minmax(0,1fr) }
    .brief,.builder { grid-template-columns:minmax(0,1fr) }
    .preview { position:static }
  }
</style>
