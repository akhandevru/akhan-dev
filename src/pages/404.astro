---
import Layout from '../layouts/Layout.astro';
import { content } from '../config';
---
<Layout title={`404 | ${content.ui.notFound}`} noindex>
  <section class="not-found" aria-labelledby="error-heading">
    <!-- Ноль в «404» это та же чёрная дыра, что на главной, только маленькая. Без WebGL остаётся обычный ноль. -->
    <div class="error-code" aria-hidden="true">
      <span class="four four-left">4</span>
      <span class="hole"><span class="zero">0</span><canvas class="hole-canvas" data-hole-mini></canvas></span>
      <span class="four four-right">4</span>
    </div>
    <div class="error-copy">
      <h1 id="error-heading"><span class="sr-only">404. </span>{content.errorPage.heading}</h1>
      <p>{content.errorPage.description}</p>
      <div class="error-actions">
        <a class="pill pill-solid pill-big" href="/">{content.ui.backHome}</a>
        <a class="pill pill-big" href="/projects/">{content.errorPage.projectsLabel}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found { display:grid; justify-items:center; align-content:center; gap:clamp(28px,5vh,56px); min-height:calc(100svh - 175px); padding-block:24px 72px; text-align:center }
  .error-code { display:flex; align-items:center; justify-content:center; gap:clamp(4px,1.4vw,24px); font:800 clamp(120px,24vw,340px)/1 var(--display); letter-spacing:-.04em; user-select:none }
  .four { display:inline-block }
  .four-left { transform-origin:100% 50% }
  .four-right { transform-origin:0 50% }

  .hole { position:relative; display:inline-grid; place-items:center; width:.8em }
  .hole-canvas { position:absolute; left:50%; top:50%; z-index:-1; width:2.8em; height:1.4em; transform:translate(-50%,-50%); pointer-events:none }
  :global(.hole-on) .zero { visibility:hidden }
  .error-code { position:relative; isolation:isolate }
  .four { position:relative; z-index:1 }
  .error-copy { display:grid; justify-items:center; gap:18px; max-width:620px }
  h1 { font:700 clamp(28px,3.4vw,52px)/1.1 var(--display); letter-spacing:-.045em; text-wrap:balance }
  .error-copy>p { max-width:46ch; color:var(--secondary); font-size:17px; line-height:1.75 }
  .error-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:12px 16px; margin-top:12px }

  @media (prefers-reduced-motion:no-preference) {
    .four-left { animation:pull-left 4.8s cubic-bezier(.45,0,.55,1) infinite }
    .four-right { animation:pull-right 4.8s cubic-bezier(.45,0,.55,1) infinite }
    /* Цифры тянутся к дыре и возвращаются: лёгкое «спагеттирование». */
    @keyframes pull-left { 50% { transform:translateX(.04em) scaleX(1.08) skewY(-3deg) } }
    @keyframes pull-right { 50% { transform:translateX(-.04em) scaleX(1.08) skewY(3deg) } }
  }
  @media (max-width:760px) {
    .not-found { min-height:calc(100svh - 250px) }
    .error-code { font-size:clamp(96px,30vw,200px) }
    .error-copy>p { font-size:15px }
    .hole-canvas { width:2.6em; height:1.3em }
  }
</style>

<script>
  import '../scripts/hole-mini';
</script>
