---
import { siteConfig, content } from '../config';
import '@fontsource-variable/onest';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/jetbrains-mono';
import unboundedCyrillic from '@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url';
import onestCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import CommandPalette from '../components/CommandPalette.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { buildGraph } from '../lib/seo';
import { metrikaId } from '../lib/analytics';
interface Props { title?: string; description?: string; noindex?: boolean; schema?: Record<string, unknown>[]; bleed?: boolean; }
const { title = siteConfig.title, description = siteConfig.description, noindex = false, schema = [], bleed = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const ogImage = new URL('/og.jpg', siteConfig.url);
const ogImageAlt = `${siteConfig.name}. ${siteConfig.role}.`;
const graph = buildGraph({ path: Astro.url.pathname, title, description, extra: schema });
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070708" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <!-- Шрифты первого экрана грузятся заранее: имя сразу рисуется нужным шрифтом, без подмены. -->
    <link rel="preload" href={unboundedCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={onestCyrillic} as="font" type="font/woff2" crossorigin />
    <!-- Вступительная анимация главной (звезда взрывается и рождается чёрная дыра): класс intro закрывает страницу чёрным экраном с первого кадра
         и блокирует прокрутку, scripts/intro.ts его снимает. Показывается не чаще раза в час (метка времени в localStorage, ключ akhan-intro);
         адрес /?intro показывает её принудительно. Не играет при «меньше движения» и без JavaScript. Страховка: через 10 секунд класс снимается сам. -->
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement, key = 'akhan-intro', now = Date.now(), last = 0;
          try { last = +localStorage.getItem(key) || 0; } catch (e) {}
          var force = /[?&]intro(=|&|$)/.test(location.search);
          if (location.pathname === '/' && !matchMedia('(prefers-reduced-motion: reduce)').matches && (force || now - last > 3600000)) {
            root.classList.add('intro');
            try { localStorage.setItem(key, String(now)); } catch (e) {}
            setTimeout(function () { root.classList.remove('intro'); }, 10000);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="application-name" content={siteConfig.brand} />
    <meta name="apple-mobile-web-app-title" content={siteConfig.brand} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body id="top">
    <div class="intro-veil" aria-hidden="true"></div>
    <canvas class="intro-star" aria-hidden="true"></canvas>
    <canvas class="intro-canvas" aria-hidden="true"></canvas>
    <canvas class="bg-shader" aria-hidden="true" data-bg-shader></canvas>
    <canvas class="ink-bg" aria-hidden="true" data-ink></canvas>
    <canvas class="three-canvas" aria-hidden="true" data-three></canvas>
    <a class="skip-link" href="#main">{content.ui.skip}</a>
    <Header />
    <main id="main" tabindex="-1" class:list={{ 'page-width': !bleed }}><slot /></main>
    <footer class="site-footer">
      <p>© {siteConfig.copyrightYear} {siteConfig.name}</p>
      <div>
        <a href="/privacy/">Конфиденциальность</a>
        <button class="footer-button" type="button" data-consent-settings>Настройки cookie</button>
        <span>{content.ui.builtWith}</span>
      </div>
    </footer>
    <Menu />
    <CookieBanner />
    <noscript><div><img src={`https://mc.yandex.ru/watch/${metrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <CommandPalette />
    <script src="../scripts/interactions.ts"></script>
    <script src="../scripts/shader-bg.ts"></script>
    <script src="../scripts/ink-bg.ts"></script>
    <script src="../scripts/parallax.ts"></script>
  </body>
</html>
